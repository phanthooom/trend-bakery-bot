# Telegram
BOT_TOKEN=your_bot_token_here
ORDERS_CHAT_ID=your_group_chat_id

# Vercel (set after first deploy)
WEBAPP_URL=https://trend-bakery-bot.vercel.app

# Vercel Blob (фото товаров)
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Firebase (Firestore) — из service account JSON
FIREBASE_PROJECT_ID=trend-bakery-bot
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@trend-bakery-bot.iam.gserviceaccount.com
# Весь private_key из JSON, в кавычках, с \n как есть (не разворачивать)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Главный админ — твой Telegram ID (число). Авто-создаётся при первом входе.
ADMIN_TELEGRAM_ID=123456789

# Supabase (заказы, опционально)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
